{
  "name": "longhand",
  "productName": "Longhand",
  "version": "0.1.0",
  "description": "A quiet code editor for students: you write the code, the AI is a read-only tutor.",
  "private": true,
  "scripts": {
    "build:web": "node build.mjs",
    "dev": "tauri dev",
    "build": "tauri build",
    "smoke": "node build.mjs && cd src-tauri && LONGHAND_SMOKE=1 cargo run",
    "preview": "node build.mjs && node scripts/preview.mjs",
    "screenshot": "node build.mjs && node scripts/preview.mjs --scenario failing-test --out docs/screenshot.png",
    "test:ui": "node build.mjs && node --test --test-reporter=spec --test-concurrency=1 'tests/ui/*.test.mjs'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:ui && cd src-tauri && cargo test"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.6",
    "esbuild": "0.28.2",
    "prettier": "3.10.1",
    "puppeteer-core": "25.19.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.2",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.8",
    "@codemirror/lsp-client": "6.3.1",
    "@codemirror/search": "6.7.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.44.2",
    "@lezer/highlight": "1.2.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.5.0",
    "katex": "0.19.1",
    "marked": "18.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wastella/longhand.git"
  }
}
